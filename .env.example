# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: GMI Cloud (MiniMax models)
# ─────────────────────────────────────────────────────────────────────────────
# One key drives every model call: MiniMax-M3 (research, scripting, memory,
# chat), MiniMax-H3 (video), Speech 2.8 HD (voices), Music 3.0 (score).
#   https://console.gmicloud.ai  ->  API keys
# MiniMax-H3 is paid ($0.13 per request); the other three are free during
# MiniMax Week. Fund the key before generating a video episode.
GMI_CLOUD_APIKEY=

# Optional. Text model id on GMI Cloud. Defaults to MiniMaxAI/MiniMax-M3.
# GMI_TEXT_MODEL=MiniMaxAI/MiniMax-M3

# Optional. MiniMax-H3 output resolution: 768P (default) or 2K.
# H3_RESOLUTION=768P

# Optional. How a clip gets its dialogue audio.
#   reference (default): attach the Speech 2.8 line as reference audio and keep
#                        H3's own track when it has one
#   native:              let H3 voice the line itself
#   overlay:             always replace the clip's audio with the Speech 2.8 line
# A silent clip always falls back to the overlay.
# H3_AUDIO_STRATEGY=reference

# Spend guard. Both caps refuse a request rather than silently degrading a show.
# Maximum MiniMax-H3 requests a single show may issue (default 14).
# H3_MAX_REQUESTS_PER_RUN=14
# Maximum cumulative MiniMax-H3 spend recorded in this database, in USD (default 8).
# H3_SESSION_CAP_USD=8

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC DEPLOYMENTS: make visitors bring their own key
# ─────────────────────────────────────────────────────────────────────────────
# Model inference is the dominant running cost. With this on, GMI_CLOUD_APIKEY
# above is never used for visitor generations: each visitor supplies their own
# GMI Cloud key in the UI and GMI bills them directly. Leave unset for local dev.
# REQUIRE_USER_API_KEYS=true
#
# Encrypts visitor keys at rest for the lifetime of their run. Required whenever
# REQUIRE_USER_API_KEYS is true.   Generate with: openssl rand -base64 32
# KEY_ENCRYPTION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: Database (PostgreSQL 14+)
# ─────────────────────────────────────────────────────────────────────────────
# Stores shows, transcripts, chat, memory and the MiniMax-H3 spend ledger.
# No extensions needed: transcript search uses Postgres full-text search.
#   DATABASE_URL=postgresql://localhost:5432/interdimensional_cable
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: Mux (video hosting and HLS delivery)
# ─────────────────────────────────────────────────────────────────────────────
# https://dashboard.mux.com/settings/access-tokens
# Note: the Mux free plan caps you at 10 assets. The generation workflow runs a
# capacity preflight and refuses to start rather than spend render money it
# cannot store.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Optional. Max stored Mux assets for your plan (default 10, the free-plan cap).
# MUX_ASSET_LIMIT=10

# Optional, for signed playback URLs.
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: everything below is unused by the show pipeline
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for public endpoints and workflow callbacks. Defaults to http://localhost:3000.
NEXT_PUBLIC_BASE_URL=

# imported talks). Needed only if you exercise those; the show pipeline never
# touches them.

# Remotion Lambda, for the legacy social-clip renderer only.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Deployment helpers, read only by scripts/vercel-env-push.sh (see DOCS/deploy.md).
# The hosted Postgres URL to push to Vercel as DATABASE_URL, and the production
# deployment to rebuild after pushing.
VERCEL_DATABASE_URL=
VERCEL_PRODUCTION_URL=
